# Apollo.io - wyszukiwanie firm i osob decyzyjnych
# https://developer.apollo.io/  (Settings -> API -> API Key)
APOLLO_API_KEY=

# Snov.io - waterfall wyszukiwania/weryfikacji e-maili gdy Apollo nie zwroci adresu
# https://app.snov.io/api-settings  (Client ID + Client Secret)
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# Anthropic (Claude) - generowanie spersonalizowanej rekomendacji kontaktu
# https://console.anthropic.com/  (API Keys)
ANTHROPIC_API_KEY=
# Opcjonalnie nadpisz model (domyslnie claude-sonnet-5)
ANTHROPIC_MODEL=

# Upstash Redis - trwale przechowywanie danych (konta, kontakty, sygnaly).
# WYMAGANE na hostingu (Vercel/Railway/Render itp.) - bez tego dane znikna
# przy restarcie serwera. Bez tych zmiennych aplikacja lokalnie i tak
# dziala (zapisuje do pliku data/db.json).
# https://console.upstash.com/ -> Create Database -> zakladka "REST API"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
